# 이름만 둔다. 값은 Vercel · GitHub 비밀값과 각자 컴퓨터의 .env.local 에만 넣고 저장소 · 장부 · 대화에 적지 않는다.
# DB 접속 문자열(서버 전용, 트랜잭션 풀러) — P3
DATABASE_URL=
# 마이그레이션 접속 문자열(서버 전용, 세션 풀러 5432) — P3
MIGRATION_DATABASE_URL=
# 가족 접근 코드의 해시(서버 전용, 쿠키 서명 열쇠의 바탕이라 비밀값으로 다룬다) — P3
ACCESS_CODE_HASH=
# Cron 경로 확인(정본 10절의 이름) — P3 확인 함수, Cron 은 1-나
CRON_SECRET=
# 시각 당기기 날 수(프리뷰만, 운영은 읽지 않음) — P3
CLOCK_SHIFT_DAYS=
# Anthropic API 키(서버 전용, SDK 가 읽는 기본 이름) — P9
ANTHROPIC_API_KEY=
# Data API 닫힘 확인(pnpm check:data-api) — 개발용 Supabase 프로젝트 주소와 키 — P3
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 레거시 anon 키(프로젝트에서 켜져 있을 때만)
SUPABASE_LEGACY_ANON_KEY=
# 시드 보기 화면(로컬 next dev 전용)의 시드 뿌리. 비우면 seed — P5
SEED_VIEWER_ROOT=
