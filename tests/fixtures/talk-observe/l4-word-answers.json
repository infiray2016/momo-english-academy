    },
    {
      "say": "My sister sings well.",
      "expect": { "followUp": true, "answerFirst": false, "koMeaning": true }
    },
    {
      "say": "I have a cat.",
      "expect": {
        "followUp": true,
        "contextlessCard": false,
        "koMeaning": true
      }
    },
    {
      "say": "She sleeps a lot.",
      "expect": { "returns": true, "contextlessCard": false, "koMeaning": true }
    },
    {
      "input": "dont_know",
      "expect": { "koMeaning": true, "sameSoundTwice": false }
    },
    {
      "say": "Kitchen.",
      "expect": {
        "recastWord": "kitchen",
        "answerFirst": false,
        "koMeaning": true
      }
    }
