  "level": 4,
  "unit": 1,
  "lesson": 1,
  "teacher": "mina",
  "note": "4단계는 짧은 준비 없이 대화하고 소리 줄이 없다. 4단계 회화 카드 시드(seed/lessons/talk/4/1.json)가 생기면 돌아간다(plan 묶음 20 둘째 프리뷰).",
  "steps": [
    {
      "say": "I'm good.",
      "expect": { "koMeaning": true }
    },
    {
      "say": "Singer.",
      "expect": {
        "recastWord": "singer",
        "followUp": true,
        "answerFirst": false,
        "koMeaning": true
